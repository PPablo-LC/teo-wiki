#!/bin/bash

# wiki-update: Sincroniza la wiki de teología con GitHub Pages
# Uso: wiki-update

WIKI_DIR="$HOME/Proyectos/teo-wiki"
SOURCE_DIR="$HOME/Dropbox/LLM-Wiki/wiki/"
CONTENT_DIR="$WIKI_DIR/content/"

echo "📚 Actualizando wiki de teología..."

# Paso 1: Sincronizar cambios de Obsidian a content/
echo "🔄 Detectando cambios en la wiki local..."
rsync -av --delete "$SOURCE_DIR" "$CONTENT_DIR"

if [ $? -ne 0 ]; then
    echo "❌ Error al sincronizar archivos locales"
    exit 1
fi

# Paso 2: Subir a GitHub
echo "☁️  Subiendo a GitHub Pages..."
cd "$WIKI_DIR" || {
    echo "❌ No se encontró la carpeta $WIKI_DIR"
    exit 1
}

npx quartz sync

if [ $? -eq 0 ]; then
    echo "✅ Wiki actualizada correctamente en https://ppablo-lc.github.io/teo-wiki"
else
    echo "❌ Hubo un error al subir a GitHub"
    exit 1
fi
